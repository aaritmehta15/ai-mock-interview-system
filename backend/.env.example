# ── Groq ──────────────────────────────────────────────────────────────────────
# Get your key from: https://console.groq.com/
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Model for event extraction and daily plan generation
GROQ_MODEL=llama-3.3-70b-versatile

# Lighter model used only for fast company tier classification
GROQ_CLASSIFY_MODEL=llama-3.1-8b-instant

# ── Gmail REST API ─────────────────────────────────────────────────────────────
# NO credentials.json needed — auth is done via Firebase Google Sign-In popup.
# The frontend sends the Google OAuth access token as: Authorization: Bearer <token>
# The backend uses it directly against https://gmail.googleapis.com/

# Max emails to fetch per /generate-plan call
GMAIL_MAX_RESULTS=20

# ── Firebase ───────────────────────────────────────────────────────────────────
# 1. Go to https://console.firebase.google.com/
# 2. Project Settings → Service Accounts → Generate new private key
# 3. Place the downloaded JSON in backend/ and set the filename below
# (If this file is missing, the system uses an in-memory store automatically)
FIREBASE_CREDENTIALS_FILE=firebase_credentials.json
FIREBASE_PROJECT_ID=lifeos-d46b1

# ── App settings ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
