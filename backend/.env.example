# ── Groq API Key (required for LLM inference & blueprint synthesis) ────────────
# Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ── LiveKit Cloud Credentials (required for real-time WebRTC voice agent) ─────
# Get free project credentials at https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ── Firebase Admin SDK (optional — used for persistent user cloud accounts) ────
# If omitted, the platform automatically runs in full-featured Guest Mode.
FIREBASE_CREDENTIALS_FILE=firebase_credentials.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── Application Settings ───────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
